# Postgres connection string. Server-side only - never prefix with EXPO_PUBLIC_,
# which would compile it into the client bundle.
DATABASE_URL=postgresql://user:password@host:5432/database

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The origin the auth API is served from (the deployed URL in production).
BETTER_AUTH_URL=http://localhost:8081
